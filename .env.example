# Dominio pubblico del sito, usato per canonical, Open Graph e dati strutturati.
# Non obbligatorio per la build: senza questa variabile i riferimenti assoluti
# puntano a http://localhost:3000. Va impostato su Vercel prima di segnalare il
# sito ai motori di ricerca.
NEXT_PUBLIC_SITE_URL=https://esempio.it
