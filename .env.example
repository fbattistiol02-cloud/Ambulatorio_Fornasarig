# Dominio pubblico del sito, usato per canonical, Open Graph e dati strutturati.
#
# NON serve impostarla su Vercel: in mancanza, la build usa da sola
# VERCEL_PROJECT_PRODUCTION_URL, cioè il dominio di produzione del progetto.
# Impostala solo quando l'ambulatorio avrà un dominio proprio, per farlo
# prevalere su quello .vercel.app.
#
# In locale, se non impostata, i metadati assoluti puntano a localhost:3000.
NEXT_PUBLIC_SITE_URL=https://esempio.it
